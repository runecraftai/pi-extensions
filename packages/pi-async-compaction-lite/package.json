{
  "name": "@runecraft/pi-async-compaction-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Precompute Pi compaction summaries without interrupting active tools.",
  "type": "module",
  "author": "Runecraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runecraftai/pi-extensions.git",
    "directory": "packages/pi-async-compaction-lite"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters",
    "test": "node --experimental-transform-types --test test/*.test.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "compaction"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.4.0 <1.5.0",
    "@earendil-works/pi-agent-core": ">=1.4.0 <1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.4.0 <1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "expect": "^30.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
