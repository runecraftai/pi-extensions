{
  "name": "@runecraft/pi-decisions",
  "version": "0.1.0",
  "private": true,
  "description": "Ask the user structured decisions in Pi and record the answers as durable, keyed decision records.",
  "type": "module",
  "author": "Runecraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runecraftai/pi-extensions.git",
    "directory": "packages/pi-decisions"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters",
    "test": "node --experimental-transform-types --test test/*.test.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "decisions",
    "squad"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
