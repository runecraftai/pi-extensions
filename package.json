{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo of pi extensions.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --experimental-transform-types --test packages/*/test/**/*.test.ts test/pi-lifecycle/*.test.mjs",
    "test:lifecycle": "node --test test/pi-lifecycle/*.test.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@runecraft/pi-polish && npm run typecheck --workspace=@runecraft/pi-async-compaction-lite",
    "build": "npm run build --workspace=@runecraft/pi-async-compaction-lite",
    "lint": "npm run lint --workspace=@runecraft/pi-async-compaction-lite",
    "test:release": "node --test test/release-config.test.mjs",
    "changeset:version": "changeset version",
    "publish:packages": "node scripts/publish-packages.mjs"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "tui",
    "monorepo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "conventional-commits-parser": "^6.4.0",
    "typescript": "^7.0.2"
  }
}
